# TERRA NASA Earth Observation Data Pipeline - Environment Configuration
# Copy this file to .env and fill in your credentials. Never commit .env!

# NASA Earthdata Login (required for downloading GPM IMERG & SMAP data granules)
# Generate an Earthdata Bearer Token at: https://urs.earthdata.nasa.gov/profile
EARTHDATA_TOKEN=

# Optional fallback credentials (used if EARTHDATA_TOKEN is not set)
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# Pipeline paths and server defaults
TERRA_CONFIG_PATH=config/farm_config.yaml
TERRA_DATASETS_PATH=config/datasets.yaml
TERRA_DATA_DIR=data
TERRA_API_HOST=0.0.0.0
TERRA_API_PORT=8000
